# HTTP address to listen on
ADDR=127.0.0.1:8080
# SQLite database path
DB_PATH=./runbook.db
# Set false only for local HTTP testing
COOKIE_SECURE=true
# Session lifetime in hours
SESSION_TTL_HOURS=720
# REQUIRED on first run (empty users table). Ignored once a user exists.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
